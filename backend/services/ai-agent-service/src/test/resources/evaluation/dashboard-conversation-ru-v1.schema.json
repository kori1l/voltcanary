{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoltCanary dashboard conversation corpus v1",
  "type": "object",
  "required": [
    "version",
    "promptVersion",
    "modelSchemaVersion",
    "cases"
  ],
  "properties": {
    "version": {
      "const": "dashboard-conversation-ru-v1"
    },
    "promptVersion": {
      "type": "string"
    },
    "modelSchemaVersion": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "critical",
          "split",
          "profile",
          "capabilityRequirements",
          "mutationPolicy",
          "cleanup",
          "turns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "critical": {
            "type": "boolean"
          },
          "split": {
            "enum": [
              "development",
              "held-out"
            ]
          },
          "profile": {
            "enum": [
              "normal",
              "stale",
              "empty",
              "ambiguous",
              "pair"
            ]
          },
          "capabilityRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mutationPolicy": {
            "const": "PLAN_ONLY"
          },
          "cleanup": {
            "const": "DECOMMISSION_OWN_FIXTURE"
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "action"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "message",
                    "recover",
                    "select",
                    "revoke",
                    "concurrent",
                    "foreign"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "expect": {
                  "$ref": "#/$defs/expectation"
                },
                "fault": {
                  "enum": [
                    "PREPARATION_TYPE_MISMATCH"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "requests": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "message",
                      "expect"
                    ],
                    "properties": {
                      "message": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expect": {
                        "$ref": "#/$defs/expectation"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "expectedHttp": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "allowedHttp": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "expectation": {
      "type": "object",
      "properties": {
        "status": {
          "oneOf": [
            {
              "enum": [
                "READY",
                "NEEDS_INPUT"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "READY",
                  "NEEDS_INPUT"
                ]
              },
              "uniqueItems": true
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(map|note|current:.+|history:.+)$"
          },
          "uniqueItems": true
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(map|note|current:.+|history:.+)$"
          },
          "uniqueItems": true
        },
        "top": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(map|note|current:.+|history:.+)$"
          },
          "uniqueItems": true
        },
        "allowNewRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(map|note|current:.+|history:.+)$"
          },
          "uniqueItems": true
        },
        "titles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "views": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "line",
              "list"
            ]
          }
        },
        "heightMax": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "period": {
          "type": "string"
        },
        "preserve": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "allowRoot": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowReflow": {
          "type": "boolean"
        },
        "unchanged": {
          "type": "boolean"
        },
        "missingField": {
          "type": "string"
        },
        "disclosureAny": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
