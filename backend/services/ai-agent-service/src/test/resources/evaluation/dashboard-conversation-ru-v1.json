        {
          "id": "name",
          "action": "message",
          "message": "Назови Мой любимый трамвай",
          "expect": {
            "status": "READY",
            "name": "Мой любимый трамвай",
            "roles": [
              "map",
              "current:speed",
              "current:doors",
              "current:stop",
              "history:speed",
              "history:doors"
            ]
          }
        },
        {
          "id": "move",
          "action": "message",
          "message": "Перемести виджеты текущей скорости и следующей остановки вверх. Информацию открыты или закрыты двери тоже хочу чтобы ты показал простым виджетом и тоже вверху. Еще по открытию закрытию дверей я хочу видеть график как со скоростью",
          "expect": {
            "status": "READY",
            "name": "Мой любимый трамвай",
