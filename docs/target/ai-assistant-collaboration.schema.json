                        "const": "NULL"
                      }
                    }
                  },
                  "valueSemantics": {
                    "const": "UNAVAILABLE"
                  }
                }
              },
              {
                "properties": {
                  "value": {
                    "not": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "NULL"
                        }
                      }
                    }
                  },
                  "valueSemantics": {
                    "const": "LOWER_BOUND"
