        "subjectRefs",
        "interval",
        "timezone",
        "unit",
        "value",
        "valueSemantics",
        "status",
        "coverage",
        "readManifestId",
        "evidenceRefs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
