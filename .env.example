# PostgreSQL
# Opt-in dashboard semantic protocol; default release waits for outcome/repair gates.
AI_DASHBOARD_OPERATIONS_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voltcanary
POSTGRES_USER=voltcanary
POSTGRES_PASSWORD=change_me
POSTGRES_ADDITIONAL_DATABASES=voltcanary_identity voltcanary_device voltcanary_analytics voltcanary_alerts voltcanary_simulator voltcanary_ai_agent
IDENTITY_POSTGRES_DB=voltcanary_identity
DEVICE_POSTGRES_DB=voltcanary_device
ANALYTICS_POSTGRES_DB=voltcanary_analytics
AI_AGENT_POSTGRES_DB=voltcanary_ai_agent

# TimescaleDB
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=voltcanary_telemetry
TIMESCALE_USER=voltcanary
TIMESCALE_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
INGESTION_IDEMPOTENCY_REDIS_ENABLED=true
INGESTION_RATE_LIMIT_REDIS_ENABLED=true
INGESTION_MULTI_REPLICA_MODE=true
INGESTION_LOCAL_CORRECTNESS_STATE_ENABLED=false

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_PORT=9092
ANALYTICS_KAFKA_CONSUME_ENABLED=true
ANALYTICS_KAFKA_PUBLISH_ENABLED=true

# JWT
JWT_KEY_ID=dev-rsa
JWT_PUBLIC_KEYS=
JWT_PRIVATE_KEY=
JWT_ISSUER=voltcanary-identity
JWT_AUDIENCE=voltcanary-api
GATEWAY_AI_RESPONSE_TIMEOUT_MS=-1
JWT_SECRET=change_me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Internal service boundary
INTERNAL_SERVICE_TOKEN=dev-internal-token
APP_INTERNAL_COVERAGE_ATTESTOR_TOKEN=
ML_RUNTIME_PROFILE=docker
ML_INTERNAL_AUTH_REQUIRED=true
ML_ALLOWED_SOURCE_SERVICES=analytics-service
ML_MAX_REQUEST_BYTES=1048576

# AI Agent model provider secrets
AI_AGENT_SECRET_ENCRYPTION_KEY=change_me_32_bytes_minimum_local_dev_key
AI_AGENT_SECRET_KEY_VERSION=v1

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=voltcanary
MINIO_ROOT_PASSWORD=change_me_change_me
MINIO_ACCESS_KEY=voltcanary
MINIO_SECRET_KEY=change_me_change_me
ML_ARTIFACT_STORE=s3
ML_ARTIFACT_BUCKET=model-artifacts
AWS_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Observability
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Telegram later
TELEGRAM_BOT_TOKEN=change_me

# Application ports
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
DEVICE_SERVICE_PORT=8082
INGESTION_SERVICE_PORT=8083
TELEMETRY_SERVICE_PORT=8084
ANALYTICS_SERVICE_PORT=8085
ALERT_SERVICE_PORT=8086
ML_SERVICE_PORT=8090
FRONTEND_PORT=3000

# Private dashboard domain
DASHBOARD_POSTGRES_DB=voltcanary_dashboard
DASHBOARD_SERVICE_PORT=8089
DASHBOARD_SERVICE_URI=http://localhost:8089
NATIVE_GENERATION_RETENTION_ENABLED=false
NATIVE_GENERATION_RETENTION_GRACE=30d
DASHBOARD_DB_URL=jdbc:postgresql://localhost:5432/voltcanary_dashboard

# Vehicle map basemap (public style URL; no credentials)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# Enable only after variable readers, topics and processing workers are deployed.
VARIABLE_ACTIVATION_ENABLED=false
VARIABLE_PROCESSING_ENABLED=false
VARIABLE_ALERTS_ENABLED=false
# Bounded Boolean/TEXT accepted-input journal only; does not enable RULE execution.
OBSERVATION_CAPTURE_ENABLED=false
OBSERVATION_CAPTURE_BINDING_IDS=
# Base64 of 32+ random bytes; shared by analytics, alert and device owner.
# Empty keeps scoped machine owner reads disabled.
APP_VCL_WORKER_HMAC_KEY=
APP_VCL_WORKER_KEY_ID=worker-1
# Diagnostic due-window drain only; requires a scoped machine key and qualified deployment fixtures.
APP_VCL_WORKER_ENABLED=false
# Publish and reconcile reviewed rule proposals through Alert Service.
APP_VCL_WORKER_ALERT_EFFECTS_ENABLED=false
APP_VCL_WORKER_DELAY=5s
AI_DEVICE_SETUP_ENABLED=false

# Main assistant orchestration (explicit local cutover; legacy reviews remain readable)
AI_ASSISTANT_V2_ENABLED=false
AI_NATIVE_DATA_ENABLED=false
APP_AI_ORCHESTRATION_PROFILE=STANDARD

# Optional deployment-owned widget capability embeddings; no account chat keys reused.
# Keep disabled until a local/approved embedding endpoint and pinned model are configured.
AI_WIDGET_EMBEDDINGS_ENABLED=false
AI_WIDGET_EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
AI_WIDGET_EMBEDDINGS_MODEL=
AI_WIDGET_EMBEDDINGS_API_KEY=
AI_WIDGET_EMBEDDINGS_TIMEOUT_MS=3000
